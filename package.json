{
  "name": "contextvault",
  "version": "1.2.0",
  "description": "A local-first context platform for AI chats, coding agents, and project memory.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "vault:init": "node scripts/vault-terminal.mjs init",
    "vault:record": "node scripts/vault-terminal.mjs record",
    "vault:list": "node scripts/vault-terminal.mjs list",
    "vault:show": "node scripts/vault-terminal.mjs show",
    "vault:export": "node scripts/vault-terminal.mjs export",
    "vault:search": "node scripts/vault-terminal.mjs search",
    "vault:index": "node scripts/vault-terminal.mjs index",
    "vault:retrieve": "node scripts/vault-terminal.mjs retrieve",
    "vault:prepare": "node scripts/vault-terminal.mjs prepare",
    "vault:memory": "node scripts/vault-terminal.mjs memory",
    "vault:link": "node scripts/vault-terminal.mjs link",
    "vault:timeline": "node scripts/vault-terminal.mjs timeline",
    "demo:vault-terminal": "python scripts/generate-vault-terminal-demo-gif.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t llm-history-observer .",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.30",
    "@types/chrome": "^0.0.270",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1"
  }
}
